# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore — không bao giờ commit file đó.

# ─── Bắt buộc ────────────────────────────────────────────────────────────────

# Chuỗi kết nối PostgreSQL.
#   Chạy trên máy   : postgresql://postgres:MAT_KHAU@localhost:5432/mercury?schema=public
#   Dịch vụ đám mây : lấy chuỗi kết nối do nhà cung cấp cấp (Neon, Supabase, Railway...)
#                     thường phải thêm ?sslmode=require
DATABASE_URL="postgresql://postgres:MAT_KHAU@localhost:5432/mercury?schema=public"

# Khóa ký cookie phiên đăng nhập (JWT HS256). BẮT BUỘC, không có mặc định, và phải
# DÀI TỐI THIỂU 32 KÝ TỰ. Để trống HOẶC ngắn hơn 32 ký tự là app TỪ CHỐI KHỞI ĐỘNG:
# instrumentation.ts kiểm ngay trong register() và ném lỗi kèm hướng dẫn sinh khóa, nên
# hỏng lộ ra ở những dòng log đầu tiên chứ không đợi tới lúc có người bấm Đăng nhập.
# (lib/session-crypto.ts còn một lớp chặn nữa nhưng chỉ đòi khác rỗng — ràng buộc thật
# sự quyết định app có lên được hay không là mốc 32 ký tự ở trên.)
#
# Dòng khai báo dưới đây cố tình để ở dạng chú thích chứ không ship sẵn giá trị:
# file này nằm trong repo, nên bất kỳ giá trị mẫu nào cũng thành khóa dùng chung
# mà ai đọc repo cũng tự ký được cookie quản trị của mọi bản cài. Chuỗi mẫu cũng cố ý
# để NGẮN HƠN 32 ký tự: ai bỏ dấu # mà quên dán khóa thật sẽ bị chặn ngay lúc khởi động
# thay vì chạy ngon lành bằng một khóa in nguyên văn trong repo — hỏng to còn hơn hỏng
# âm thầm với cookie quản trị mà ai đọc repo cũng tự ký được.
#
# Tự sinh khóa 32 byte rồi bỏ dấu # ở dòng cuối và dán chuỗi hex vào:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# Đổi khóa này sẽ vô hiệu mọi phiên đang đăng nhập — người dùng phải đăng nhập lại.
# SESSION_SECRET="DAN_CHUOI_HEX_VAO_DAY"

# ─── Tùy chọn ────────────────────────────────────────────────────────────────

# Thư mục lưu file báo cáo tải lên (mặc định ./uploads; trong Docker là /data/uploads).
# UPLOAD_DIR="./uploads"

# Đặt false khi chạy sau HTTP thuần (không HTTPS) để cookie session hoạt động.
# COOKIE_SECURE="false"

# Mật khẩu 3 tài khoản mẫu do `prisma db seed` tạo ra
# (admin@ / master@ / crew@example.com). BẮT BUỘC khi chạy seed — thiếu thì seed
# dừng ngay, không dùng mật khẩu tạm (chuỗi tạm nằm trong repo công khai).
# SEED_PASSWORD=""

# ─── Thông tin công ty in trên chứng từ PO / RFQ ─────────────────────────────
# Quy ước: FORM_<MÃ BIỂU MẪU>_<TRƯỜNG>. Đây là giá trị khởi tạo khi seed —
# sau đó sửa trực tiếp trong app tại trang /purchasing/forms.

# FORM_MLS_LABEL="MLS — Tên hiển thị"
# FORM_MLS_COMPANY_NAME="TÊN CÔNG TY QUẢN LÝ TÀU"
# FORM_MLS_ADDRESS="Head office: ..."
# FORM_MLS_REP_ADDRESS="Rep Add: ..."
# FORM_MLS_TEL="(+84) ..."
# FORM_MLS_EMAIL="tech@example.com"
# FORM_MLS_WEBSITE="https://example.com"

# FORM_NAVIS_LABEL="NAVIS — Tên hiển thị"
# FORM_NAVIS_COMPANY_NAME="TÊN CÔNG TY QUẢN LÝ TÀU THỨ HAI"
# FORM_NAVIS_ADDRESS="Head office: ..."
# FORM_NAVIS_TEL="(+84) ..."
# FORM_NAVIS_EMAIL="tech2@example.com"
