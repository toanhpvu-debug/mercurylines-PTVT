# Chép file này thành deploy/.env TRÊN VPS rồi điền giá trị thật.
# deploy/.env đã nằm trong .gitignore — không bao giờ commit.
#
#   cp deploy/env.hostinger.example deploy/.env
#   nano deploy/.env

# ─── Tên miền & HTTPS ────────────────────────────────────────────────────────

# Tên miền đã trỏ bản ghi A về IP của VPS. Phải trỏ xong TRƯỚC khi chạy,
# nếu không Let's Encrypt không cấp được chứng chỉ.
DOMAIN="vattu.tenmiencuaban.com"

# Email nhận thông báo hết hạn chứng chỉ.
ACME_EMAIL="ban@tenmiencuaban.com"

# ─── Bảo mật ─────────────────────────────────────────────────────────────────

# Khóa ký cookie phiên. Bỏ trống thì container tự sinh và lưu vào volume.
# Muốn đặt tay thì sinh bằng: openssl rand -hex 32
SESSION_SECRET=""

# Mật khẩu 3 tài khoản mẫu (admin@ / master@ / crew@example.com) tạo ở lần seed
# đầu tiên. BẮT BUỘC điền, và đổi ngay sau khi đăng nhập lần đầu.
SEED_PASSWORD=""

# ─── Thông tin công ty in trên chứng từ PO / RFQ ─────────────────────────────
# Chỉ có tác dụng ở LẦN SEED ĐẦU TIÊN. Sau đó sửa trong app tại /purchasing/forms.

FORM_MLS_LABEL="MLS — Tên hiển thị"
FORM_MLS_COMPANY_NAME="TÊN CÔNG TY QUẢN LÝ TÀU"
FORM_MLS_ADDRESS="Head office: ..."
FORM_MLS_REP_ADDRESS="Rep Add: ..."
FORM_MLS_TEL="(0084) ..."
FORM_MLS_EMAIL="tech@..."
FORM_MLS_WEBSITE="http://..."

FORM_NAVIS_LABEL="NAVIS — Tên hiển thị"
FORM_NAVIS_COMPANY_NAME="TÊN CÔNG TY QUẢN LÝ TÀU THỨ HAI"
FORM_NAVIS_ADDRESS="Head office: ..."
FORM_NAVIS_TEL="+84..."
FORM_NAVIS_EMAIL="tech@..."
