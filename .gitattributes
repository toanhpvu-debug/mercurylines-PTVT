# Chuẩn hóa xuống dòng: repo luôn lưu LF, tránh diff giả khi làm việc trên Windows.
* text=auto eol=lf

# Script Windows giữ CRLF — batch (.cmd) có thể chạy sai với LF,
# và PowerShell đọc chuẩn hơn khi đúng quy ước Windows.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# File nhị phân — không đụng vào nội dung.
*.png binary
*.ico binary
*.woff2 binary
*.woff binary
*.xlsx binary
*.xls binary
*.pdf binary
