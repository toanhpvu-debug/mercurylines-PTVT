generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CREW")
  isActive  Boolean  @default(true)
  vesselId  Int?
  vessel    Vessel?  @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  documents ReportDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([vesselId])
}

// File báo cáo tải lên từ tàu — BẤT BIẾN: không có action sửa;
// chỉ ADMIN được xóa; sha256 chứng minh toàn vẹn nội dung.
model ReportDocument {
  id           Int      @id @default(autoincrement())
  vesselId     Int
  vessel       Vessel   @relation(fields: [vesselId], references: [id])
  title        String
  reportType   String
  period       String?
  fileName     String
  storedName   String   @unique
  mimeType     String
  size         Int
  sha256       String
  note         String?
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  @@index([vesselId])
  @@index([uploadedById])
}

model Vessel {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String
  imo              String?
  flag             String?
  vesselType       String?
  status           String            @default("ACTIVE")
  // Chuẩn biểu mẫu công ty quản lý tàu (MLS / NAVIS) — quyết định đầu chứng từ PO, RFQ, Service Order.
  formStandard     String            @default("MLS")
  hullNo           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  warehouses       Warehouse[]
  inventories      Inventory[]
  materialRequests MaterialRequest[]
  users            User[]
  lashingGears     LashingGear[]
  lashingReports   LashingReport[]
  documents        ReportDocument[]
  vesselMaterials  VesselMaterial[]
  purchaseOrders   PurchaseOrder[]
  paintAreas        PaintArea[]
  paintStocks       PaintStock[]
  paintJobs         PaintJob[]
  paintTransactions PaintTransaction[]
}

model Warehouse {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  name          String
  warehouseType String
  vesselId      Int?
  vessel        Vessel?     @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  inventories   Inventory[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([vesselId])
}

model Category {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Material {
  id           Int                   @id @default(autoincrement())
  code         String                @unique
  nameVn       String
  nameEn       String?
  impa         String?
  issa         String?
  partNumber   String?
  manufacturer String?
  uom          String                @default("PCS")
  materialType String                @default("STORE") // STORE = vật tư (MLS-11-05B), SPARE = phụ tùng (MLS-11-05A)
  equipment    String?               // thiết bị/máy gắn với phụ tùng
  categoryId   Int?
  category     Category?             @relation(fields: [categoryId], references: [id])
  minStock     Float                 @default(0)
  maxStock     Float                 @default(0)
  isCritical   Boolean               @default(false)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  inventories  Inventory[]
  requestItems MaterialRequestItem[]
  vesselMaterials VesselMaterial[]
  poItems      PurchaseOrderItem[]
  @@index([categoryId])
  @@index([materialType])
  @@index([isActive])
}

// Danh mục vật tư riêng của từng tàu: tàu nào dùng vật tư nào.
model VesselMaterial {
  id         Int      @id @default(autoincrement())
  vesselId   Int
  vessel     Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([vesselId, materialId])
  @@index([materialId])
}

// Biểu mẫu chứng từ (công ty quản lý) — thêm/bớt được. Vessel.formStandard tham chiếu code.
model FormStandard {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  label       String
  companyName String
  address     String
  repAddress  String?
  tel         String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id               Int       @id @default(autoincrement())
  materialId       Int
  warehouseId      Int
  vesselId         Int
  quantity         Float     @default(0)
  reservedQuantity Float     @default(0)
  material         Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  vessel           Vessel    @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([materialId, warehouseId])
  @@index([vesselId])
  @@index([warehouseId])
}

model InventoryTransaction {
  id          Int      @id @default(autoincrement())
  type        String
  materialId  Int
  warehouseId Int
  vesselId    Int
  quantity    Float
  note        String?
  // Thời điểm THỰC HIỆN nhập/xuất (cho phép ghi lùi khi nhập bù) — báo cáo tính theo mốc này.
  occurredAt  DateTime @default(now())
  // Người thực hiện giao dịch (ghi tự động từ tài khoản đăng nhập).
  performedBy String?
  // Thời điểm ghi sổ vào hệ thống (audit).
  createdAt   DateTime @default(now())
  @@index([vesselId])
  @@index([materialId])
  @@index([warehouseId])
  @@index([occurredAt])
}

model MaterialRequest {
  id           Int                   @id @default(autoincrement())
  requestNo    String                @unique
  kind         String                @default("STORE") // STORE = yêu cầu vật tư (MLS-11-05B), SPARE = yêu cầu phụ tùng (MLS-11-05A)
  vesselId     Int
  vessel       Vessel                @relation(fields: [vesselId], references: [id])
  requestedBy  String
  department   String
  status       String                @default("DRAFT")
  priority     String                @default("NORMAL")
  requiredDate DateTime?
  purpose      String?
  notes        String?
  // Thông tin thiết bị cho yêu cầu phụ tùng (MLS-11-05A)
  equipment    String?
  maker        String?
  serialNo     String?
  items        MaterialRequestItem[]
  events       MaterialRequestEvent[]
  // Vết phê duyệt — in lên ô ký của biểu mẫu MLS-11-05 và tra cứu nhanh.
  submittedBy     String?
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  @@index([vesselId])
  @@index([status])
}

// Nhật ký mọi lần đổi trạng thái của một yêu cầu — ai, khi nào, vì sao.
// Yêu cầu vật tư là chứng từ có phê duyệt nên phải truy được trách nhiệm.
model MaterialRequestEvent {
  id         Int             @id @default(autoincrement())
  requestId  Int
  request    MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorName  String
  actorRole  String
  note       String?
  createdAt  DateTime        @default(now())
  @@index([requestId])
}

model LashingGear {
  id          Int                 @id @default(autoincrement())
  vesselId    Int
  vessel      Vessel              @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  name        String
  partNo      String?
  minQty      Float               @default(0)
  standardQty Float               @default(0)
  sortOrder   Int                 @default(0)
  reportLines LashingReportLine[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([vesselId, name])
}

model LashingReport {
  id         Int                 @id @default(autoincrement())
  vesselId   Int
  vessel     Vessel              @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  reportDate DateTime
  voyageNo   String?
  position   String?
  createdBy  String
  lines      LashingReportLine[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  @@index([vesselId])
}

model LashingReportLine {
  id          Int           @id @default(autoincrement())
  reportId    Int
  report      LashingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  gearId      Int
  gear        LashingGear   @relation(fields: [gearId], references: [id], onDelete: Cascade)
  // Snapshot tại thời điểm lập báo cáo — báo cáo cũ không đổi khi sửa danh mục chuẩn
  gearName    String        @default("")
  partNo      String?
  minQty      Float         @default(0)
  standardQty Float         @default(0)
  inOrder     Float         @default(0)
  outOfOrder  Float         @default(0)
  @@index([reportId])
  @@index([gearId])
}

model MaterialRequestItem {
  id               Int              @id @default(autoincrement())
  requestId        Int
  request          MaterialRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // materialId trống = vật tư MỚI ngoài danh mục, nhập tay ở các trường item* bên dưới.
  materialId       Int?
  material         Material?        @relation(fields: [materialId], references: [id])
  itemName         String? // Tên vật tư / phụ tùng mới
  itemCode         String? // Mã IMPA (vật tư) hoặc Part No (phụ tùng) cho vật tư mới
  itemUom          String? // Đơn vị cho vật tư mới
  quantity         Float // SL yêu cầu (REQ)
  robSnapshot      Float            @default(0) // Còn tồn trên tàu tại thời điểm yêu cầu (ROB)
  approvedQuantity Float            @default(0) // SL duyệt (APP)
  suppliedQuantity Float            @default(0) // SL đã nhận về (từ mua sắm)
  note             String?
  poItems          PurchaseOrderItem[]
  @@index([requestId])
  @@index([materialId])
}

// Nhà cung cấp
model Supplier {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  contact        String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

// Đơn mua hàng (Purchase Order)
model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  poNo         String              @unique
  supplierId   Int
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  vesselId     Int
  vessel       Vessel              @relation(fields: [vesselId], references: [id])
  // DRAFT, SENT, CONFIRMED, PARTIALLY_RECEIVED, RECEIVED, CLOSED, CANCELLED
  status       String              @default("DRAFT")
  currency     String              @default("USD")
  orderDate    DateTime?
  expectedDate DateTime?
  notes        String?
  // Các trường theo biểu mẫu PO/RFQ công ty
  subject         String?
  supplierRef     String? // Y/ref của nhà cung cấp
  discountPercent Float   @default(0)
  transportFee    Float   @default(0)
  deliveryFee     Float   @default(0)
  createdBy    String
  items        PurchaseOrderItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  @@index([vesselId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               Int                  @id @default(autoincrement())
  poId             Int
  po               PurchaseOrder        @relation(fields: [poId], references: [id], onDelete: Cascade)
  // Nguồn từ dòng yêu cầu vật tư (nếu tạo từ yêu cầu)
  requestItemId    Int?
  requestItem      MaterialRequestItem? @relation(fields: [requestItemId], references: [id])
  materialId       Int?
  material         Material?            @relation(fields: [materialId], references: [id])
  description      String
  partNo           String?
  uom              String               @default("PCS")
  quantity         Float // SL đặt
  unitPrice        Float                @default(0)
  quantityReceived Float                @default(0)
  warehouseId      Int? // kho đã nhập khi nhận hàng (không FK, giống InventoryTransaction)
  @@index([poId])
  @@index([requestItemId])
  @@index([materialId])
}

// ─── Quản lý sơn ────────────────────────────────────────────────────────────
// Sơn tách khỏi Material vì có thuộc tính riêng (hệ sơn, độ phủ, DFT, mã màu)
// và quy trình riêng: sơ đồ sơn theo khu vực → thi công → trừ tồn.

// Danh mục sơn dùng chung toàn đội (giống Material — định nghĩa một lần).
model PaintProduct {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  maker    String?
  // PRIMER, ANTI_CORROSIVE, ANTI_FOULING, TOPCOAT, DECK, TANK, OTHER
  paintType String @default("OTHER")
  colorCode String?
  colorName String?
  uom       String @default("L")
  // Dung tích một lon/thùng (lít) — để quy đổi khi nhập theo lon.
  packSize  Float  @default(0)
  // Độ phủ lý thuyết (m²/lít) tại chiều dày khô khuyến nghị.
  coverage  Float  @default(0)
  // Chiều dày màng khô khuyến nghị mỗi lớp (micron).
  dftPerCoat Float @default(0)
  thinner    String?
  isActive   Boolean @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schemeLayers PaintSchemeLayer[]
  stocks       PaintStock[]
  jobLines     PaintJobLine[]
  transactions PaintTransaction[]
}

// Khu vực sơn của từng tàu — do người dùng tự khai báo (không seed sẵn).
model PaintArea {
  id        Int    @id @default(autoincrement())
  vesselId  Int
  vessel    Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  name      String
  // Diện tích khu vực (m²) — dùng để ước lượng lượng sơn cần.
  areaM2    Float  @default(0)
  sortOrder Int    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  layers PaintSchemeLayer[]
  jobs   PaintJob[]

  @@unique([vesselId, name])
}

// Một lớp trong sơ đồ sơn của khu vực: lớp mấy, sơn gì, mấy lớp, DFT bao nhiêu.
model PaintSchemeLayer {
  id        Int          @id @default(autoincrement())
  areaId    Int
  area      PaintArea    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  productId Int
  product   PaintProduct @relation(fields: [productId], references: [id])
  // Thứ tự lớp: 1 = lớp lót trong cùng.
  layerNo   Int   @default(1)
  coats     Int   @default(1)
  dft       Float @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([areaId])
  @@index([productId])
}

// Tồn sơn theo tàu (sơn để trên tàu, không chia kho như vật tư).
model PaintStock {
  id        Int          @id @default(autoincrement())
  vesselId  Int
  vessel    Vessel       @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  productId Int
  product   PaintProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float @default(0)
  minQty    Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vesselId, productId])
  @@index([productId])
}

// Nhập / xuất sơn — giữ vết mọi thay đổi tồn, kể cả do thi công.
model PaintTransaction {
  id        Int          @id @default(autoincrement())
  vesselId  Int
  vessel    Vessel       @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  productId Int
  product   PaintProduct @relation(fields: [productId], references: [id])
  // IN = nhận sơn lên tàu, OUT = xuất dùng (thi công hoặc hao hụt)
  type      String
  quantity  Float
  // Nếu phát sinh từ một lần thi công thì gắn với công việc đó.
  jobId     Int?
  job       PaintJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  note        String?
  occurredAt  DateTime @default(now())
  performedBy String?
  createdAt   DateTime @default(now())
  @@index([vesselId])
  @@index([productId])
  @@index([jobId])
  @@index([occurredAt])
}

// Một lần thi công sơn.
model PaintJob {
  id         Int        @id @default(autoincrement())
  vesselId   Int
  vessel     Vessel     @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  areaId     Int?
  area       PaintArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  jobDate    DateTime
  // Diện tích thực sơn đợt này (m²) và số lớp đã phủ.
  paintedM2  Float @default(0)
  coats      Int   @default(1)
  // Điều kiện thi công — ảnh hưởng chất lượng màng sơn, cần cho hồ sơ.
  weather     String?
  airTemp     Float?
  humidity    Float?
  surfaceTemp Float?
  performedBy String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines        PaintJobLine[]
  transactions PaintTransaction[]
  @@index([vesselId])
  @@index([areaId])
}

// Sơn đã dùng trong một lần thi công.
model PaintJobLine {
  id        Int          @id @default(autoincrement())
  jobId     Int
  job       PaintJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  productId Int
  product   PaintProduct @relation(fields: [productId], references: [id])
  quantity  Float
  note      String?
  @@index([jobId])
  @@index([productId])
}

// ─── Đồng bộ tàu ↔ văn phòng ────────────────────────────────────────────────
// Mỗi tàu chạy một bản app riêng, làm việc không cần mạng. Khi có mạng thì
// xuất phần thay đổi thành gói và gửi về văn phòng, đồng thời nhận danh mục
// dùng chung mới về.

model SyncState {
  id Int @id @default(autoincrement())
  /** "GUI_DI" = tàu gửi lên văn phòng, "NHAN_VE" = nhận từ văn phòng. */
  huong String
  /** Mã tàu của bản cài này; văn phòng để trống. */
  vesselCode String?
  /** Mốc thời gian của lần đồng bộ gần nhất — lần sau chỉ lấy thay đổi sau mốc này. */
  lastSyncAt DateTime
  /** Số bản ghi của lần gần nhất, để đối chiếu khi có nghi ngờ. */
  lastCount Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([huong, vesselCode])
}

// Bản cài này là của tàu nào (hoặc là văn phòng). Chỉ có đúng một dòng.
model SiteConfig {
  id Int @id @default(1)
  /** Mã tàu nếu là bản cài trên tàu; để trống nghĩa là bản văn phòng. */
  vesselCode String?
  /** Dải id dành riêng cho bản cài này, tránh trùng id khi gộp dữ liệu. */
  idRangeStart BigInt @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
